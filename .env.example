# Done reads process environment variables directly. It does not load this
# file automatically. Source it in your shell or configure these variables in
# your process manager.

HOST=127.0.0.1
PORT=4173

CLAUDE_COMMAND=claude
CLAUDE_MODEL=
CLAUDE_MAX_TURNS=30
CLAUDE_MAX_BUDGET_USD=
CLAUDE_AUTOCOMPACT=auto

# Leave empty to use the built-in defaults. These directories contain private
# task data and must never be committed.
DATA_DIR=
DATABASE_PATH=
TASKS_DIR=
